  "cycle:dead"        "Мёртвый: сайт недоступен ни по одной ссылке"
  "cycle:unlisted"    "Исключённый: временно исключён из каталога"
  "net:www"           "Сайт доступен в клирнете"
  "net:tor"           "Сайт доступен в сети Tor"
  "net:i2p"           "Сайт доступен в сети I2P"
  "service:board"     "Борда: форумоподобная дискуссионная площадка"
  "service:chat"      "Чат, чатоподобная площадка для общения"
  "service:wiki"      "База знаний, вики-система"
  "service:blog"      "Персональный или коллективный блог"
  "service:archive"   "Архив: статичное содержимое только для чтения"
  "service:gallery"   "Галерея: коллекция тематических изображений"
  "service:index"     "Индекс: список ссылок бордосферы"
  "service:news"      "Новости, обзоры и обсуждения"
