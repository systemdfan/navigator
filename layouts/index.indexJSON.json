{{- /*
  layouts/index.indexJSON.json
  Генерирует /index.json — собственная схема навигатора (index_scheme.json).
*/ -}}

{{- $allSites := slice -}}
{{- range (readDir "content/sites") -}}
  {{- if strings.HasSuffix .Name ".yaml" -}}
    {{- $raw := readFile (printf "content/sites/%s" .Name) -}}
    {{- $s := $raw | transform.Unmarshal -}}
    {{- $allSites = $allSites | append $s -}}
  {{- end -}}
{{- end -}}

{{- /* Собираем все уникальные теги */ -}}
{{- $allTagIds := slice -}}
{{- range $allSites -}}
  {{- range (.tags | default slice) -}}
    {{- if not (in $allTagIds .) -}}
      {{- $allTagIds = $allTagIds | append . -}}
    {{- end -}}
  {{- end -}}
{{- end -}}

{{- /* Описания тегов */ -}}
{{- $tagDescriptions := dict
