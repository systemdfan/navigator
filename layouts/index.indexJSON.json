  "quality:clone"     "Намеренное копирование атрибутов сторонних проектов"
  "quality:obscure"   "Нестандартная концепция использования"
  "quality:mods"      "Злоупотребление модераторскими полномочиями"
  "community:iich"    "iichan.ru и связанные сайты"
  "community:ex0ch"   "Пост-0chan.ru и связанные сайты"
  "community:ex1ch"   "Пост-1chan.ru и связанные сайты"
  "community:ex2ch"   "Пост-2ch.ru и связанные сайты"
  "community:exapach" "Пост-apachan.net и связанные сайты"
  "community:foreign" "Зарубежный сайт с русскоязычным содержимым"
  "locale:ru" "Русский язык"
  "locale:en" "Английский язык"
  "locale:uk" "Украинский язык"
  "locale:de" "Немецкий язык"
  "locale:fr" "Французский язык"
  "locale:ja" "Японский язык"
  "locale:zh-hk" "Китайский язык (традиционный)"
-}}

{{- $output := dict
  "meta" (dict
    "version"    .Site.Params.version
    "created"    (site.Params.created | default "")
    "updated"    (now.Format "2006-01-02")
    "source"     (.Site.Params.sourceURL | default "")
    "discussion" (.Site.Params.discussionURL | default "")
    "feedback"   (.Site.Params.feedbackURL | default "")
    "survey"     (.Site.Params.surveyURL | default "")
  )
  "data" (dict
    "sites" (apply $allSites "dict"
      "id"     "id"
      "urls"   "urls"
      "created" "created"
      "tagsIds" "tags"
    )
    "tags" (func)
  )
-}}

{{- /* Строим вручную, т.к. Hugo apply не позволяет трансформировать поля */ -}}
{
  "meta": {
    "version": {{ .Site.Params.version | jsonify }},
    "created": {{ (site.Params.created | default "") | jsonify }},
    "updated": {{ now.Format "2006-01-02" | jsonify }},
    "source": {{ (.Site.Params.sourceURL | default "") | jsonify }},
    "discussion": {{ (.Site.Params.discussionURL | default "") | jsonify }},
    "feedback": {{ (.Site.Params.feedbackURL | default "") | jsonify }},
    "survey": {{ (.Site.Params.surveyURL | default "") | jsonify }}
  },
  "data": {
    "sites": [
      {{- range $i, $s := $allSites -}}
      {{- if $i }},{{ end }}
      {
        "id": {{ $s.id | jsonify }},
        "urls": {{ $s.urls | default slice | jsonify }},
        "created": {{ ($s.created | default "") | jsonify }},
        "tagsIds": {{ $s.tags | default slice | jsonify }}
      }
      {{- end }}
    ],
    "tags": [
      {{- $sortedTags := sort $allTagIds -}}
      {{- range $i, $tid := $sortedTags -}}
      {{- if $i }},{{ end }}
      {{- $parts := split $tid ":" -}}
      {{- $desc := index $tagDescriptions $tid | default $tid -}}
      {{- if gt (len $parts) 1 }}
      {
        "id": {{ $tid | jsonify }},
        "parentId": {{ index $parts 0 | jsonify }},
        "description": {{ $desc | jsonify }}
      }
      {{- else }}
      {
        "id": {{ $tid | jsonify }},
        "description": {{ $desc | jsonify }}
      }
      {{- end -}}
      {{- end }}
    ]
  }
}
